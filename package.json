{
  "name": "webmcp-tour",
  "version": "0.1.0",
  "description": "Guided tours for AI agents via WebMCP: one script tag, and any agent can highlight and explain your app's controls.",
  "license": "MIT",
  "author": "Filipe Boldo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fboldo/webmcp-tour.git"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context",
    "guided-tour",
    "onboarding",
    "agent"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": "./dist/webmcp-tour.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/webmcp-tour.js",
  "jsdelivr": "./dist/webmcp-tour.js",
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-size.mjs",
    "prepublishOnly": "pnpm check",
    "sri": "node scripts/sri.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "pins": "node scripts/release-prepare.mjs --check",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm size && pnpm pins",
    "demo": "pnpm build && node scripts/serve-demo.mjs",
    "example:script-tag": "pnpm build && node examples/serve.mjs script-tag",
    "example:embed": "pnpm build && node examples/serve.mjs embed",
    "docs:dev": "pnpm build && node site/build.mjs --dev",
    "docs:build": "pnpm build && node site/build.mjs",
    "docs:deploy": "pnpm build && node site/deploy.mjs",
    "example:bundled": "pnpm build && pnpm --filter webmcp-tour-example-bundled dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@w3c/webmcp-polyfill": "0.1.1",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "marked": "^18.2.1",
    "playwright": "^1.65.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
